@inherits LayoutComponentBase
@inject AuthClientService Auth
@inject NavigationManager Navigation

<div class="page">
    <header class="app-header">
        <nav class="navbar navbar-expand-lg navbar-dark container">
            <a class="navbar-brand" href="">
                <span class="brand-badge"><i class="bi bi-check2-square"></i></span>
                ToDoList
            </a>

            <AuthorizeView>
                <Authorized>
                    <div class="ms-3 d-none d-lg-block">
                        <NavMenu />
                    </div>
                    <div class="ms-auto d-flex align-items-center gap-2">
                        <span class="user-chip">
                            <span class="avatar"><i class="bi bi-person-fill"></i></span>
                            @context.User.Identity?.Name
                            <span class="role-pill">@RoleOf(context)</span>
                        </span>
                        <button class="btn btn-outline-light btn-sm" @onclick="LogoutAsync">
                            <i class="bi bi-box-arrow-right me-1"></i>Logout
                        </button>
                    </div>
                    <div class="w-100 d-lg-none mt-3">
                        <NavMenu />
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="ms-auto d-flex gap-2">
                        <a class="btn btn-outline-light btn-sm" href="login">Login</a>
                        <a class="btn btn-light btn-sm" href="register">Register</a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </header>

    <main class="container pb-5">
        @Body
    </main>
</div>

<ToastContainer />

@code {
    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Navigation.NavigateTo("login", replace: true);
    }

    private static string RoleOf(AuthenticationState context)
        => context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "User";
}