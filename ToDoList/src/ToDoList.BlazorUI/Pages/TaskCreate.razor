@page "/tasks/new"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ToDoClientService Todo
@inject ToastService Toasts
@inject NavigationManager Navigation

<PageTitle>New Task — ToDoList</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0"><i class="bi bi-plus-circle me-2"></i>New Task</h3>
</div>

<div class="page-card">
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger py-2">@_error</div>
    }

    <TaskForm Model="_model"
              ShowCompleted="false"
              SubmitLabel="Create"
              Busy="_busy"
              OnValidSubmit="HandleSubmitAsync"
              OnCancel="Cancel" />
</div>

@code {
    private readonly TaskFormModel _model = new();
    private bool _busy;
    private string? _error;

    private async Task HandleSubmitAsync()
    {
        _busy = true;
        _error = null;

        var result = await Todo.CreateAsync(_model.ToCreateRequest());

        _busy = false;

        if (result.Success)
        {
            Toasts.ShowSuccess("Task created.");
            Navigation.NavigateTo("");
        }
        else
        {
            _error = result.ErrorMessage ?? "Could not create the task.";
        }
    }

    private void Cancel() => Navigation.NavigateTo("");
}
