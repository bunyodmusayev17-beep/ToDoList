@implements IDisposable
@inject ToastService Toasts

<div class="toast-container">
    @foreach (var toast in Toasts.Toasts)
    {
        <div class="toast show align-items-center text-white border-0 mb-2 @CssFor(toast.Level)" role="alert">
            <div class="d-flex">
                <div class="toast-body">
                    <i class="bi @IconFor(toast.Level) me-2"></i>@toast.Text
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto"
                        @onclick="() => Toasts.Remove(toast.Id)"></button>
            </div>
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => Toasts.OnChange += OnToastsChanged;

    public void Dispose() => Toasts.OnChange -= OnToastsChanged;

    private void OnToastsChanged() => InvokeAsync(StateHasChanged);

    private static string CssFor(ToastLevel level) => level switch
    {
        ToastLevel.Success => "bg-success",
        ToastLevel.Error => "bg-danger",
        ToastLevel.Warning => "bg-warning text-dark",
        _ => "bg-primary"
    };

    private static string IconFor(ToastLevel level) => level switch
    {
        ToastLevel.Success => "bi-check-circle",
        ToastLevel.Error => "bi-exclamation-octagon",
        ToastLevel.Warning => "bi-exclamation-triangle",
        _ => "bi-info-circle"
    };
}
